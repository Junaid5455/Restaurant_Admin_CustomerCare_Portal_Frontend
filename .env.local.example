# Django API base (must include /api/v1, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Currency symbol shown in prices ("Rs" in the design, backend default currency is USD)
NEXT_PUBLIC_CURRENCY_SYMBOL=Rs

# Only needed once STRIPE_SECRET_KEY is set on the backend (live card payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
